#!/bin/bash
# owrt-bot: lets the router shut down, reboot and suspend this PC, and
# turns on Wake-on-LAN. Generated for device "{{.Device}}".
#
#   curl -fsSL {{.ScriptURL}} | bash
#
# What it does:
#   1. re-runs itself through sudo if it is not root;
#   2. installs and starts sshd;
#   3. creates a system user "owrt-bot" (no password, sign-in by key only);
#   4. adds the router's key with restrict,command=: with that key only
#      off / reboot / sleep / check can run, no shell, no forwarding;
#   5. lets that user run systemctl poweroff/reboot/suspend through sudo;
#   6. turns on wake on magic packet;
#   7. reports back to the bot.
set -eu

KEY='{{.Key}}'
REPORT='{{.ReportURL}}'
SELF='{{.ScriptURL}}'
ROUTER='{{.RouterIP}}'
BOT_USER=owrt-bot
POWER=/usr/local/sbin/owrt-bot-power

say() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mx\033[0m %s\n' "$*" >&2; exit 1; }

if [ "$(id -u)" != 0 ]; then
	command -v sudo >/dev/null || die "нужны права root: запусти от root или поставь sudo"
	say "нужны права root, запрашиваю через sudo"
	exec sudo bash -c "curl -fsSL '$SELF' | bash"
fi

# What this script changes is recorded, so the removal script undoes
# exactly that and leaves things that were already there.
STATE=/var/lib/owrt-bot/state
mkdir -p /var/lib/owrt-bot
touch "$STATE"
remember() { grep -q "^$1=" "$STATE" || echo "$1=$2" >>"$STATE"; }

# 1. sshd
if ! command -v sshd >/dev/null 2>&1 && [ ! -x /usr/sbin/sshd ]; then
	say "устанавливаю OpenSSH server"
	remember installed_sshd 1
	if command -v apt-get >/dev/null; then apt-get update -qq && apt-get install -y -qq openssh-server
	elif command -v dnf >/dev/null; then dnf install -y -q openssh-server
	elif command -v pacman >/dev/null; then pacman -S --noconfirm --needed openssh
	elif command -v zypper >/dev/null; then zypper -q install -y openssh
	elif command -v apk >/dev/null; then apk add -q openssh
	else die "не знаю, как поставить openssh-server на этот дистрибутив"
	fi
fi
systemctl enable --now ssh >/dev/null 2>&1 || systemctl enable --now sshd >/dev/null 2>&1 || warn "не удалось включить службу ssh"
say "sshd запущен"

# 2. The service user. Password "*" means no password login, but unlike a
# locked "!" account sshd still accepts its key.
if ! id "$BOT_USER" >/dev/null 2>&1; then
	useradd --system --create-home --shell /bin/sh --comment "owrt-bot power control" "$BOT_USER"
	say "создан пользователь $BOT_USER"
	remember created_user 1
fi
usermod -p '*' "$BOT_USER"
HOME_DIR=$(getent passwd "$BOT_USER" | cut -d: -f6)
GROUP=$(id -gn "$BOT_USER")

# 3. What the key may run
SYSTEMCTL=$(command -v systemctl)
cat >"$POWER" <<EOF
#!/bin/sh
# Called by sshd for the owrt-bot key; the router sends one word.
case "\$SSH_ORIGINAL_COMMAND" in
	off) exec sudo -n $SYSTEMCTL poweroff ;;
	reboot) exec sudo -n $SYSTEMCTL reboot ;;
	sleep) exec sudo -n $SYSTEMCTL suspend ;;
	check) echo ok ;;
	*) echo "owrt-bot: unknown command" >&2; exit 1 ;;
esac
EOF
chmod 755 "$POWER"

install -d -m 700 -o "$BOT_USER" -g "$GROUP" "$HOME_DIR/.ssh"
printf 'restrict,command="%s" %s\n' "$POWER" "$KEY" >"$HOME_DIR/.ssh/authorized_keys"
chown "$BOT_USER:$GROUP" "$HOME_DIR/.ssh/authorized_keys"
chmod 600 "$HOME_DIR/.ssh/authorized_keys"
say "ключ роутера добавлен: им можно только выключить, перезагрузить и усыпить ПК"

# 4. sudo for exactly three commands
command -v sudo >/dev/null || warn "sudo не установлен: выключение работать не будет"
RULE=/etc/sudoers.d/owrt-bot
printf '%s ALL=(root) NOPASSWD: %s poweroff, %s reboot, %s suspend\n' "$BOT_USER" "$SYSTEMCTL" "$SYSTEMCTL" "$SYSTEMCTL" >"$RULE.tmp"
chmod 440 "$RULE.tmp"
if visudo -cf "$RULE.tmp" >/dev/null 2>&1; then
	mv "$RULE.tmp" "$RULE"
else
	rm -f "$RULE.tmp"
	warn "visudo отклонил правило, выключение работать не будет"
fi

# 5. Wake-on-LAN on the interface that leads to the router
IFACE=$(ip route get "$ROUTER" 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1)}' | head -n1)
MAC=""
if [ -n "$IFACE" ]; then
	MAC=$(cat "/sys/class/net/$IFACE/address" 2>/dev/null || true)
	if [ -d "/sys/class/net/$IFACE/wireless" ]; then
		warn "$IFACE это Wi-Fi: из выключенного состояния WoL по Wi-Fi почти никогда не работает, нужен кабель"
	fi
	CONN=$(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | awk -F: -v d="$IFACE" '$2 == d {print $1; exit}')
	if [ -n "$CONN" ]; then
		nmcli connection modify "$CONN" 802-3-ethernet.wake-on-lan magic && say "WoL включён в NetworkManager ($CONN)"
	elif command -v ethtool >/dev/null; then
		ethtool -s "$IFACE" wol g && say "WoL включён на $IFACE (ethtool, до перезагрузки)"
	else
		warn "нет ни NetworkManager, ни ethtool: включи Wake-on-LAN на $IFACE вручную"
	fi
fi

# 6. Tell the bot
if command -v curl >/dev/null; then
	curl -fsS -X POST --data-urlencode "user=$BOT_USER" --data-urlencode "os=linux" \
		--data-urlencode "host=$(hostname)" --data-urlencode "mac=$MAC" "$REPORT" >/dev/null
else
	wget -qO- --post-data "user=$BOT_USER&os=linux&host=$(hostname)&mac=$MAC" "$REPORT" >/dev/null
fi && say "готово, бот проверит подключение и напишет в Telegram" || warn "не удалось сообщить боту"
