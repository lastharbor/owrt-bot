# owrt-bot: removes everything the setup script added to this PC.
# Generated for device "{{.Device}}".
#
#   irm {{.ScriptURL}} | iex
#
# Removes the owrt-bot user and its profile, the router's key, the sshd
# rule for that user and C:\ProgramData\owrt-bot. OpenSSH Server and its
# firewall rule are removed only if the setup script installed them, and
# Fast Startup goes back to what it was. Wake on magic packet stays on.

$ErrorActionPreference = 'Stop'
$Report = '{{.ReportURL}}'
$Self = '{{.ScriptURL}}'
$BotUser = 'owrt-bot'
$Dir = Join-Path $env:ProgramData 'owrt-bot'
$StateFile = Join-Path $Dir 'state.json'
$KeysFile = Join-Path $env:ProgramData 'ssh\owrt-bot_authorized_keys'
$SshdConfig = Join-Path $env:ProgramData 'ssh\sshd_config'

function Say($m) { Write-Host "==> $m" -ForegroundColor Green }
function Warn($m) { Write-Host "!   $m" -ForegroundColor Yellow }

$principal = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
	Say 'Нужны права администратора, открываю окно с запросом...'
	Start-Process powershell -Verb RunAs -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-NoExit', '-Command', "irm '$Self' | iex")
	return
}

$state = if (Test-Path $StateFile) { Get-Content $StateFile -Raw | ConvertFrom-Json } else { [pscustomobject]@{} }

# The router's key and the sshd rule
Remove-Item -Path $KeysFile -Force -ErrorAction SilentlyContinue
if (Test-Path $SshdConfig) {
	$cfg = Get-Content $SshdConfig -Raw
	$clean = $cfg -replace '(?m)\r?\nMatch User owrt-bot\r?\n\s*AuthorizedKeysFile __PROGRAMDATA__/ssh/owrt-bot_authorized_keys\r?\n?', ''
	if ($clean -ne $cfg) { Set-Content -Path $SshdConfig -Value $clean -NoNewline -Encoding ascii }
}
Say 'Ключ роутера и правило sshd удалены'

# The user and its profile
if (Get-LocalUser -Name $BotUser -ErrorAction SilentlyContinue) {
	$sid = (Get-LocalUser -Name $BotUser).SID.Value
	# Rights are stored by SID and outlive the user, so drop the remote
	# shutdown right first.
	Add-Type -TypeDefinition @'
using System; using System.Runtime.InteropServices; using System.Security.Principal;
public static class OwrtLsa {
	[StructLayout(LayoutKind.Sequential)] struct LsaString { public ushort Length, MaximumLength; public IntPtr Buffer; }
	[StructLayout(LayoutKind.Sequential)] struct LsaAttrs { public int Length; public IntPtr RootDirectory, ObjectName; public int Attributes; public IntPtr SecurityDescriptor, SecurityQualityOfService; }
	[DllImport("advapi32.dll")] static extern uint LsaOpenPolicy(IntPtr system, ref LsaAttrs attrs, int access, out IntPtr policy);
	[DllImport("advapi32.dll")] static extern uint LsaRemoveAccountRights(IntPtr policy, byte[] sid, bool all, LsaString[] rights, uint count);
	[DllImport("advapi32.dll")] static extern uint LsaClose(IntPtr policy);
	public static uint Revoke(string sidText, string right) {
		var sid = new SecurityIdentifier(sidText);
		var raw = new byte[sid.BinaryLength]; sid.GetBinaryForm(raw, 0);
		var attrs = new LsaAttrs(); IntPtr policy;
		uint st = LsaOpenPolicy(IntPtr.Zero, ref attrs, 0x810, out policy);
		if (st != 0) return st;
		var r = new LsaString[1];
		r[0].Buffer = Marshal.StringToHGlobalUni(right);
		r[0].Length = (ushort)(right.Length * 2); r[0].MaximumLength = (ushort)(r[0].Length + 2);
		try { return LsaRemoveAccountRights(policy, raw, false, r, 1); } finally { Marshal.FreeHGlobal(r[0].Buffer); LsaClose(policy); }
	}
}
'@
	if ([OwrtLsa]::Revoke($sid, 'SeRemoteShutdownPrivilege') -ne 0) { Warn 'не удалось снять право SeRemoteShutdownPrivilege' }
	Remove-LocalUser -Name $BotUser
	Get-CimInstance Win32_UserProfile | Where-Object SID -eq $sid | Remove-CimInstance -ErrorAction SilentlyContinue
	Say "Пользователь $BotUser удалён"
}
Remove-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon\SpecialAccounts\UserList' -Name $BotUser -ErrorAction SilentlyContinue

# Fast Startup back to what it was
if ($state.PSObject.Properties.Name -contains 'hiberbootBefore' -and $null -ne $state.hiberbootBefore) {
	Set-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Power' -Name HiberbootEnabled -Value $state.hiberbootBefore
	Say 'Быстрый запуск вернул как было'
}

# OpenSSH Server only if the setup installed it
if ($state.installedOpenSSH) {
	Stop-Service sshd -ErrorAction SilentlyContinue
	if ($state.installedOpenSSH -eq 'winget') {
		$winget = Get-Command winget -ErrorAction SilentlyContinue
		if (-not $winget) {
			$localWinget = Join-Path $env:LOCALAPPDATA 'Microsoft\WindowsApps\winget.exe'
			if (Test-Path $localWinget) { $winget = $localWinget }
		}
		if ($winget) {
			& $winget uninstall --id Microsoft.OpenSSH.Preview --silent | Out-Null
		}
	} else {
		$cap = Get-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0' -ErrorAction SilentlyContinue
		if ($cap -and $cap.State -eq 'Installed') { Remove-WindowsCapability -Online -Name $cap.Name | Out-Null }
	}
	Remove-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue
	Say 'OpenSSH Server удалён (его ставил скрипт настройки)'
} elseif (Get-Service sshd -ErrorAction SilentlyContinue) {
	Restart-Service sshd
	Say 'OpenSSH Server оставлен: он стоял до настройки'
}

Remove-Item -Path $Dir -Recurse -Force -ErrorAction SilentlyContinue

try {
	Invoke-RestMethod -Method Post -Uri $Report -Body @{ user = $BotUser; os = 'windows'; host = $env:COMPUTERNAME; action = 'removed' } | Out-Null
	Say 'Готово. Бот уберёт выключение у этого устройства.'
} catch {
	Warn "не удалось сообщить боту: $($_.Exception.Message)"
}
