#!/bin/bash
# owrt-bot: removes everything the setup script added to this PC.
# Generated for device "{{.Device}}".
#
#   curl -fsSL {{.ScriptURL}} | bash
#
# Removes the owrt-bot user with its home, the power wrapper and the sudo
# rule. openssh-server is removed only if the setup script installed it.
# Wake-on-LAN stays on.
set -eu

REPORT='{{.ReportURL}}'
SELF='{{.ScriptURL}}'
BOT_USER=owrt-bot
STATE=/var/lib/owrt-bot/state

say() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mx\033[0m %s\n' "$*" >&2; exit 1; }

if [ "$(id -u)" != 0 ]; then
	command -v sudo >/dev/null || die "нужны права root: запусти от root или поставь sudo"
	say "нужны права root, запрашиваю через sudo"
	exec sudo bash -c "curl -fsSL '$SELF' | bash"
fi

rm -f /etc/sudoers.d/owrt-bot /usr/local/sbin/owrt-bot-power
say "правило sudo и обёртка удалены"

if id "$BOT_USER" >/dev/null 2>&1; then
	pkill -u "$BOT_USER" 2>/dev/null || true
	userdel -r "$BOT_USER" 2>/dev/null || userdel "$BOT_USER"
	say "пользователь $BOT_USER удалён"
fi

if grep -q '^installed_sshd=1' "$STATE" 2>/dev/null; then
	warn "удаляю openssh-server: его ставил скрипт настройки"
	if command -v apt-get >/dev/null; then apt-get remove -y -qq openssh-server
	elif command -v dnf >/dev/null; then dnf remove -y -q openssh-server
	elif command -v pacman >/dev/null; then pacman -R --noconfirm openssh
	elif command -v zypper >/dev/null; then zypper -q remove -y openssh
	elif command -v apk >/dev/null; then apk del -q openssh
	fi
else
	say "openssh-server оставлен: он стоял до настройки"
fi
rm -rf /var/lib/owrt-bot

if command -v curl >/dev/null; then
	curl -fsS -X POST --data-urlencode "user=$BOT_USER" --data-urlencode "os=linux" \
		--data-urlencode "host=$(hostname)" --data-urlencode "action=removed" "$REPORT" >/dev/null
else
	wget -qO- --post-data "user=$BOT_USER&os=linux&host=$(hostname)&action=removed" "$REPORT" >/dev/null
fi && say "готово, бот уберёт выключение у этого устройства" || warn "не удалось сообщить боту"
