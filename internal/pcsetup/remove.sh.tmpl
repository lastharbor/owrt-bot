#!/bin/sh
# owrt-bot: removes everything the setup script added to this PC.
# Generated for device "{{.Device}}".
#
#   curl -fsSL {{.ScriptURL}} | sh
#   wget -qO- {{.ScriptURL}} | sh
#
# Removes the owrt-bot user with its home, the power wrapper and the sudo
# rule. openssh-server and sudo are removed only if the setup script
# installed them. Wake-on-LAN stays on: the bot can still wake the PC
# without the power controls.
set -eu

REPORT='{{.ReportURL}}'
SELF='{{.ScriptURL}}'
BOT_USER=owrt-bot
STATE=/var/lib/owrt-bot/state

say() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mx\033[0m %s\n' "$*" >&2; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }

if has curl; then FETCH="curl -fsSL"; else FETCH="wget -qO-"; fi

if [ "$(id -u)" != 0 ]; then
	if has sudo; then ELEVATE=sudo
	elif has doas; then ELEVATE=doas
	else die "нужны права root: запусти от root или поставь sudo"
	fi
	say "нужны права root, запрашиваю через $ELEVATE"
	exec $ELEVATE sh -c "$FETCH '$SELF' | sh"
fi

# pkg_remove <apt/dnf/zypper/apk name> <pacman name>
pkg_remove() {
	if has apt-get; then DEBIAN_FRONTEND=noninteractive apt-get remove -y -qq "$1"
	elif has dnf; then dnf remove -y -q "$1"
	elif has yum; then yum remove -y -q "$1"
	elif has pacman; then pacman -R --noconfirm "$2"
	elif has zypper; then zypper -q remove -y "$1"
	elif has apk; then apk del -q "$1"
	elif has opkg; then opkg remove "$1"
	fi
}

rm -f /etc/sudoers.d/owrt-bot /usr/local/sbin/owrt-bot-power
say "правило sudo и обёртка удалены"

if id "$BOT_USER" >/dev/null 2>&1; then
	pkill -u "$BOT_USER" 2>/dev/null || true
	if has userdel; then
		userdel -r "$BOT_USER" 2>/dev/null || userdel "$BOT_USER"
	else
		# BusyBox
		deluser --remove-home "$BOT_USER" 2>/dev/null || deluser "$BOT_USER"
	fi
	say "пользователь $BOT_USER удалён"
fi

if grep -q '^installed_sshd=1' "$STATE" 2>/dev/null; then
	warn "удаляю openssh-server: его ставил скрипт настройки"
	pkg_remove openssh-server openssh || pkg_remove openssh openssh || true
else
	say "openssh-server оставлен: он стоял до настройки"
fi
if grep -q '^installed_sudo=1' "$STATE" 2>/dev/null; then
	warn "удаляю sudo: его ставил скрипт настройки"
	pkg_remove sudo sudo || true
fi
rm -rf /var/lib/owrt-bot

if [ -f /etc/systemd/system/owrt-bot-wol@.service ] || [ -f /etc/local.d/owrt-bot-wol.start ]; then
	say "Wake-on-LAN оставлен включённым. Выключить: удали /etc/systemd/system/owrt-bot-wol@.service или /etc/local.d/owrt-bot-wol.start"
fi

if has curl; then
	curl -fsS -X POST --data-urlencode "user=$BOT_USER" --data-urlencode "os=linux" \
		--data-urlencode "host=$(cat /proc/sys/kernel/hostname)" --data-urlencode "action=removed" "$REPORT" >/dev/null
else
	wget -qO- --post-data "user=$BOT_USER&os=linux&host=$(cat /proc/sys/kernel/hostname)&action=removed" "$REPORT" >/dev/null
fi && say "готово, бот уберёт выключение у этого устройства" || warn "не удалось сообщить боту"
