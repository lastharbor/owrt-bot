# owrt-bot: lets the router shut down, reboot and suspend this PC, and
# turns on what Wake-on-LAN needs. Generated for device "{{.Device}}".
#
#   irm {{.ScriptURL}} | iex
#
# What it does:
#   1. asks for administrator rights if it does not have them;
#   2. installs and starts OpenSSH Server, port 22 open for the local network only;
#   3. creates a hidden local user "owrt-bot" (not an administrator, random
#      password nobody knows, sign-in by key only);
#   4. adds the router's key with restrict,command=: with that key only
#      off / reboot / sleep / check can run, no shell, no forwarding;
#   5. turns off Fast Startup and lets the network card wake the PC;
#   6. reports back to the bot.

$ErrorActionPreference = 'Stop'
$Key = '{{.Key}}'
$Report = '{{.ReportURL}}'
$Self = '{{.ScriptURL}}'
$BotUser = 'owrt-bot'
$Dir = Join-Path $env:ProgramData 'owrt-bot'
$Power = Join-Path $Dir 'power.ps1'
$KeysFile = Join-Path $env:ProgramData 'ssh\owrt-bot_authorized_keys'
$SshdConfig = Join-Path $env:ProgramData 'ssh\sshd_config'

function Say($m) { Write-Host "==> $m" -ForegroundColor Green }
function Warn($m) { Write-Host "!   $m" -ForegroundColor Yellow }

$principal = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
	Say 'Нужны права администратора, открываю окно с запросом...'
	Start-Process powershell -Verb RunAs -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-NoExit', '-Command', "irm '$Self' | iex")
	return
}

# What this script changes is recorded in state.json, so the removal
# script undoes exactly that and leaves things that were already there.
New-Item -ItemType Directory -Force -Path $Dir | Out-Null
$StateFile = Join-Path $Dir 'state.json'
$state = if (Test-Path $StateFile) { Get-Content $StateFile -Raw | ConvertFrom-Json } else { [pscustomobject]@{} }
function Remember($name, $value) {
	if (-not ($state.PSObject.Properties.Name -contains $name)) {
		$state | Add-Member -NotePropertyName $name -NotePropertyValue $value
	}
}

# 1. OpenSSH Server
$cap = Get-WindowsCapability -Online | Where-Object Name -like 'OpenSSH.Server*' | Select-Object -First 1
if ($cap.State -ne 'Installed') {
	Say 'Устанавливаю OpenSSH Server (до пары минут)...'
	Add-WindowsCapability -Online -Name $cap.Name | Out-Null
	Remember 'installedOpenSSH' $true
}
Remember 'installedOpenSSH' $false
Set-Service -Name sshd -StartupType Automatic
Start-Service sshd # creates sshd_config on first start

$rule = Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue
if (-not $rule) {
	$rule = New-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -DisplayName 'OpenSSH Server (sshd)' -Direction Inbound -Protocol TCP -LocalPort 22 -Action Allow
}
$rule | Set-NetFirewallRule -Enabled True -Profile Any
$rule | Get-NetFirewallAddressFilter | Set-NetFirewallAddressFilter -RemoteAddress LocalSubnet
Say 'OpenSSH Server работает, порт 22 открыт только для локальной сети'

# 2. The service user
if (-not (Get-LocalUser -Name $BotUser -ErrorAction SilentlyContinue)) {
	$chars = [char[]]'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!#%+-='
	$pass = -join (1..32 | ForEach-Object { $chars[(Get-Random -Maximum $chars.Length)] })
	$secure = ConvertTo-SecureString $pass -AsPlainText -Force
	New-LocalUser -Name $BotUser -Password $secure -PasswordNeverExpires -AccountNeverExpires -UserMayNotChangePassword -Description 'owrt-bot: power control from the router' | Out-Null
	Remove-Variable pass, secure
	Say "Создан пользователь $BotUser"
	Remember 'createdUser' $true
}
Add-LocalGroupMember -SID 'S-1-5-32-545' -Member $BotUser -ErrorAction SilentlyContinue # Users
$hide = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon\SpecialAccounts\UserList'
New-Item -Path $hide -Force | Out-Null
Set-ItemProperty -Path $hide -Name $BotUser -Value 0 -Type DWord
Say "$BotUser скрыт с экрана входа"

# 3. What the key may run
@'
# Called by sshd for the owrt-bot key; the router sends one word.
switch ($env:SSH_ORIGINAL_COMMAND) {
	'off'    { shutdown /s /t 5 /c "owrt-bot" }
	'reboot' { shutdown /r /t 5 /c "owrt-bot" }
	'sleep'  {
		Add-Type -AssemblyName System.Windows.Forms
		[void][System.Windows.Forms.Application]::SetSuspendState('Suspend', $false, $false)
	}
	'check'  { 'ok' }
	default  { Write-Error "owrt-bot: unknown command '$env:SSH_ORIGINAL_COMMAND'"; exit 1 }
}
'@ | Set-Content -Path $Power -Encoding ascii
icacls $Dir /inheritance:r /grant '*S-1-5-32-544:(OI)(CI)F' /grant '*S-1-5-18:(OI)(CI)F' /grant '*S-1-5-32-545:(OI)(CI)RX' | Out-Null

$line = "restrict,command=`"powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $Power`" $Key"
Set-Content -Path $KeysFile -Value $line -Encoding ascii
icacls $KeysFile /inheritance:r /grant '*S-1-5-32-544:F' /grant '*S-1-5-18:F' | Out-Null

$cfg = Get-Content $SshdConfig -Raw
if ($cfg -notmatch '(?m)^Match User owrt-bot') {
	Add-Content -Path $SshdConfig -Encoding ascii -Value "`r`nMatch User owrt-bot`r`n`tAuthorizedKeysFile __PROGRAMDATA__/ssh/owrt-bot_authorized_keys`r`n"
}
Restart-Service sshd
Say 'Ключ роутера добавлен: им можно только выключить, перезагрузить и усыпить ПК'

# 4. Wake-on-LAN
$powerKey = 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Power'
Remember 'hiberbootBefore' ((Get-ItemProperty -Path $powerKey -Name HiberbootEnabled -ErrorAction SilentlyContinue).HiberbootEnabled)
Set-ItemProperty -Path $powerKey -Name HiberbootEnabled -Value 0
Say 'Быстрый запуск выключен (с ним WoL из выключенного состояния обычно не работает)'
$route = Get-NetRoute -DestinationPrefix '0.0.0.0/0' -ErrorAction SilentlyContinue | Sort-Object RouteMetric | Select-Object -First 1
$nic = if ($route) { Get-NetAdapter -InterfaceIndex $route.InterfaceIndex } else { Get-NetAdapter -Physical | Where-Object Status -eq 'Up' | Select-Object -First 1 }
$mac = ''
if ($nic) {
	$mac = $nic.MacAddress
	try {
		Set-NetAdapterPowerManagement -Name $nic.Name -WakeOnMagicPacket Enabled -ErrorAction Stop
	} catch { Warn "драйвер $($nic.Name) не дал включить пробуждение по magic packet" }
	powercfg /deviceenablewake "$($nic.InterfaceDescription)" 2>$null | Out-Null
	Say "Пробуждение по сети включено на $($nic.Name)"
	if ($nic.MediaType -match '802.11' -or $nic.Name -match 'Wi-?Fi|Wireless') {
		Warn 'это Wi-Fi: из выключенного состояния WoL по Wi-Fi почти никогда не работает, нужен кабель'
	}
}

$state | ConvertTo-Json | Set-Content -Path $StateFile -Encoding ascii

# 5. Tell the bot
try {
	Invoke-RestMethod -Method Post -Uri $Report -Body @{ user = $BotUser; os = 'windows'; host = $env:COMPUTERNAME; mac = $mac } | Out-Null
	Say 'Готово. Бот проверит подключение и напишет в Telegram.'
} catch {
	Warn "не удалось сообщить боту: $($_.Exception.Message)"
}
